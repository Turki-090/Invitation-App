{
  "name": "@dawah/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run src --passWithNoTests",
    "test:integration": "vitest run test/integration --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=15000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dawah/api-contract": "workspace:*",
    "@dawah/config": "workspace:*",
    "@dawah/domain": "workspace:*",
    "@dawah/imports": "workspace:*",
    "@dawah/messaging": "workspace:*",
    "@dawah/queue": "workspace:*",
    "@dawah/storage": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.4",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jose": "6.1.2",
    "multer": "2.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dawah/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.13",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
