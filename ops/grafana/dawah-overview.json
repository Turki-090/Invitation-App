{
  "uid": "dawah-overview",
  "title": "Dawah — platform overview",
  "description": "Operational overview for the Dawah platform. Every query targets a metric defined in packages/observability/src/platform-metrics.ts.",
  "tags": ["dawah", "stage10"],
  "timezone": "Asia/Riyadh",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(dawah_build_info, environment)",
        "refresh": 1,
        "includeAll": false
      },
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Host-visible health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deployed release",
      "description": "More than one value means a rollout is in progress or stalled.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "dawah_build_info{environment=\"$environment\"}",
          "legendFormat": "{{service}} {{release}}",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API request rate by status class",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(dawah_http_requests_total{environment=\"$environment\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server error ratio",
      "description": "Paging threshold is 2% sustained for ten minutes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.02 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(dawah_http_errors_total{environment=\"$environment\", kind=\"server\"}[5m])) / clamp_min(sum(rate(dawah_http_requests_total{environment=\"$environment\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(dawah_http_request_duration_seconds_bucket{environment=\"$environment\"}[10m]))))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests in flight",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "dawah_http_requests_in_flight{environment=\"$environment\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Queues",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backlog age by queue",
      "description": "The primary queue health signal. Paging threshold is five minutes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dawah_queue_oldest_waiting_job_age_seconds{environment=\"$environment\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue depth by state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "sum by (queue, state) (dawah_queue_depth{environment=\"$environment\"})",
          "legendFormat": "{{queue}} / {{state}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Job outcomes",
      "description": "Any exhausted job is an incident; retried jobs are expected under provider pressure.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(dawah_queue_jobs_total{environment=\"$environment\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Job duration p95 by queue",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(dawah_queue_job_duration_seconds_bucket{environment=\"$environment\"}[10m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "WhatsApp provider",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Provider outcomes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(dawah_provider_requests_total{environment=\"$environment\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Provider latency p95 by operation",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(dawah_provider_request_duration_seconds_bucket{environment=\"$environment\"}[10m])))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Business outcomes",
      "description": "Reconciled against the event report during the pilot review.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (increase(dawah_domain_events_total{environment=\"$environment\"}[1h]))",
          "legendFormat": "{{kind}} / {{outcome}}"
        }
      ]
    }
  ]
}
