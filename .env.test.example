# Copy to .env.test for local integration and startup-smoke tests.
NODE_ENV="test"
DAWAH_ENV="test"
DATABASE_URL="postgresql://dawah_test:dawah_test@localhost:5434/dawah_test?schema=public"
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="dawah:test"

STORAGE_ENDPOINT="http://localhost:7070"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="dawah-test-access-key"
STORAGE_SECRET_ACCESS_KEY="dawah-test-secret-key"
STORAGE_PRIVATE_BUCKET="dawah-private-test"
STORAGE_FORCE_PATH_STYLE="true"

IMPORT_MAX_FILE_BYTES="8388608"
IMPORT_MAX_ROWS="5000"
IMPORT_MAX_COLUMNS="64"
IMPORT_MAX_CELL_CHARACTERS="1000"
ASSET_MAX_FILE_BYTES="8388608"
ASSET_MAX_IMAGE_PIXELS="24000000"

DAWAH_DEV_AUTH_BYPASS="false"
NEXT_PUBLIC_DAWAH_DEV_AUTH_BYPASS="false"

META_WHATSAPP_APP_SECRET="dawah-test-meta-app-secret"
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="dawah-test-meta-verify-token"
META_WHATSAPP_ACCESS_TOKEN="dawah-test-meta-access-token"
META_WHATSAPP_PHONE_NUMBER_ID="000000000000000"
META_WHATSAPP_MEDIA_PUBLIC_BASE_URL="http://127.0.0.1:4100/api/v1"
META_WHATSAPP_MEDIA_SIGNING_SECRET="dawah-test-meta-media-signing-secret"
META_WHATSAPP_MEDIA_URL_TTL_SECONDS="900"
META_WHATSAPP_GRAPH_API_VERSION="v25.0"
META_WHATSAPP_REQUEST_TIMEOUT_MS="10000"
META_WHATSAPP_SEND_CONCURRENCY="2"
META_WHATSAPP_MAX_SENDS_PER_SECOND="10"
META_WHATSAPP_MAX_ATTEMPTS="5"
META_WHATSAPP_RSVP_CONFIRMATION_TEMPLATE_AR="dawah_rsvp_confirmation_ar"
META_WHATSAPP_RSVP_CONFIRMATION_TEMPLATE_EN="dawah_rsvp_confirmation_en"

API_PORT="4100"
WORKER_PORT="4101"
API_CORS_ORIGINS="http://127.0.0.1:3100"
API_BODY_LIMIT_BYTES="1048576"
API_READY_TIMEOUT_MS="3000"
WORKER_READY_TIMEOUT_MS="3000"
NEXT_PUBLIC_API_URL="http://127.0.0.1:4100/api/v1"
