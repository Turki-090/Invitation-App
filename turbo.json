{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DAWAH_ENV", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "ASSET_MAX_FILE_BYTES",
        "ASSET_MAX_IMAGE_PIXELS",
        "API_BODY_LIMIT_BYTES",
        "API_CORS_ORIGINS",
        "API_PORT",
        "API_READY_TIMEOUT_MS",
        "DATABASE_URL",
        "DAWAH_DEV_AUTH_BYPASS",
        "BILLING_ENABLED",
        "CHECK_IN_ENABLED",
        "CHECK_IN_TOKEN_SIGNING_SECRET",
        "EXPORT_DOWNLOAD_SIGNING_SECRET",
        "EXPORT_DOWNLOAD_URL_TTL_SECONDS",
        "EXPORT_RETENTION_HOURS",
        "IMPORT_MAX_CELL_CHARACTERS",
        "LOG_FORMAT",
        "LOG_LEVEL",
        "METRICS_ENABLED",
        "METRICS_TOKEN",
        "IMPORT_MAX_COLUMNS",
        "IMPORT_MAX_FILE_BYTES",
        "IMPORT_MAX_ROWS",
        "META_WHATSAPP_RSVP_CONFIRMATION_TEMPLATE_AR",
        "META_WHATSAPP_RSVP_CONFIRMATION_TEMPLATE_EN",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_DAWAH_DEV_AUTH_BYPASS",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "QUEUE_PREFIX",
        "PAYMENTS_ENABLED",
        "REDIS_URL",
        "RELEASE_VERSION",
        "SENTRY_DSN",
        "SENTRY_SAMPLE_RATE",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_ENDPOINT",
        "STORAGE_FORCE_PATH_STYLE",
        "STORAGE_PRIVATE_BUCKET",
        "STORAGE_REGION",
        "STORAGE_SECRET_ACCESS_KEY",
        "SUPABASE_JWT_AUDIENCE",
        "SUPABASE_URL",
        "WORKER_PORT",
        "WORKER_READY_TIMEOUT_MS"
      ],
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
