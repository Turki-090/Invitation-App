# PostgreSQL and Redis are local defaults. Never reuse production credentials locally.
NODE_ENV="development"
DAWAH_ENV="local"
DATABASE_URL="postgresql://dawah:dawah@localhost:5433/dawah?schema=public"
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="dawah:local"

# Private S3-compatible storage. Docker Compose exposes VersityGW on port 7070;
# applications in the app profile override localhost with the service hostname.
STORAGE_ENDPOINT="http://localhost:7070"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="dawah-local-access-key"
STORAGE_SECRET_ACCESS_KEY="dawah-local-secret-key"
STORAGE_PRIVATE_BUCKET="dawah-private"
STORAGE_FORCE_PATH_STYLE="true"
EXPORT_DOWNLOAD_SIGNING_SECRET="dawah-local-export-download-signing-secret"
EXPORT_DOWNLOAD_URL_TTL_SECONDS="300"
EXPORT_RETENTION_HOURS="168"
CHECK_IN_ENABLED="true"
CHECK_IN_TOKEN_SIGNING_SECRET="dawah-local-check-in-token-signing-secret"
BILLING_ENABLED="false"
PAYMENTS_ENABLED="false"
API_THROTTLE_TTL_SECONDS="60"
API_THROTTLE_LIMIT="120"

# Upload and parser safety limits.
IMPORT_MAX_FILE_BYTES="8388608"
IMPORT_MAX_ROWS="5000"
IMPORT_MAX_COLUMNS="64"
IMPORT_MAX_CELL_CHARACTERS="1000"
ASSET_MAX_FILE_BYTES="8388608"
ASSET_MAX_IMAGE_PIXELS="24000000"

# Supabase Auth. The API validates standard bearer JWTs; native clients can use the same contract.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_AUDIENCE="authenticated"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"

# Authentica sign-in code delivery. Supabase Auth still generates and verifies
# the code; Authentica only carries it. Enabling it requires a reachable hook
# URL configured in the Supabase dashboard, so it stays off locally.
AUTHENTICA_OTP_ENABLED="false"
AUTHENTICA_BASE_URL="https://api.authentica.sa/api/v2"
AUTHENTICA_API_KEY="dawah-local-authentica-api-key"
AUTHENTICA_OTP_METHOD="whatsapp"
AUTHENTICA_OTP_TEMPLATE_ID="1"
AUTHENTICA_REQUEST_TIMEOUT_MS="10000"
SUPABASE_SEND_SMS_HOOK_SECRET=""

# Local testing only. Both flags must be enabled, and the API still refuses the
# development credential unless NODE_ENV=development.
DAWAH_DEV_AUTH_BYPASS="false"
NEXT_PUBLIC_DAWAH_DEV_AUTH_BYPASS="false"

# Meta WhatsApp Cloud API. Local defaults are inert and must never be used in a
# deployed environment. Template names are configured on invitation templates.
META_WHATSAPP_APP_SECRET="dawah-local-meta-app-secret"
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="dawah-local-meta-verify-token"
META_WHATSAPP_ACCESS_TOKEN="dawah-local-meta-access-token"
META_WHATSAPP_PHONE_NUMBER_ID="000000000000000"
META_WHATSAPP_MEDIA_PUBLIC_BASE_URL="http://localhost:4000/api/v1"
META_WHATSAPP_MEDIA_SIGNING_SECRET="dawah-local-meta-media-signing-secret"
META_WHATSAPP_MEDIA_URL_TTL_SECONDS="900"
META_WHATSAPP_GRAPH_API_VERSION="v25.0"
META_WHATSAPP_REQUEST_TIMEOUT_MS="10000"
META_WHATSAPP_SEND_CONCURRENCY="4"
META_WHATSAPP_MAX_SENDS_PER_SECOND="10"
META_WHATSAPP_MAX_ATTEMPTS="5"
META_WHATSAPP_RSVP_CONFIRMATION_TEMPLATE_AR="dawah_rsvp_confirmation_ar"
META_WHATSAPP_RSVP_CONFIRMATION_TEMPLATE_EN="dawah_rsvp_confirmation_en"

# Observability. Local development keeps a readable console; deployed
# environments are validated to use structured JSON at info level or above.
LOG_LEVEL="info"
LOG_FORMAT="pretty"
RELEASE_VERSION=""
METRICS_ENABLED="true"
METRICS_TOKEN="dawah-local-metrics-scrape-token-value"
SENTRY_DSN=""
SENTRY_SAMPLE_RATE="1"

API_PORT="4000"
WORKER_PORT="4001"
API_CORS_ORIGINS="http://localhost:3000"
API_BODY_LIMIT_BYTES="1048576"
API_READY_TIMEOUT_MS="2000"
WORKER_READY_TIMEOUT_MS="2000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
