# PostgreSQL and Redis are local defaults. Never reuse production credentials locally.
NODE_ENV="development"
DAWAH_ENV="local"
DATABASE_URL="postgresql://dawah:dawah@localhost:5433/dawah?schema=public"
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="dawah:local"

# Supabase Auth. The API validates standard bearer JWTs; native clients can use the same contract.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_AUDIENCE="authenticated"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"

# Local testing only. Both flags must be enabled, and the API still refuses the
# development credential unless NODE_ENV=development.
DAWAH_DEV_AUTH_BYPASS="false"
NEXT_PUBLIC_DAWAH_DEV_AUTH_BYPASS="false"

API_PORT="4000"
WORKER_PORT="4001"
API_CORS_ORIGINS="http://localhost:3000"
API_BODY_LIMIT_BYTES="1048576"
API_READY_TIMEOUT_MS="2000"
WORKER_READY_TIMEOUT_MS="2000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
